{
 "compilerOptions": {
   "lib": ["DOM", "DOM.Iterable", "ES2023"],
   "target": "ES2023",
   "allowJs": true,
   "skipLibCheck": true,
   "isolatedModules": true,
   "strict": true,
   "noEmit": true,
   "esModuleInterop": true,
   "allowSyntheticDefaultImports": true,
   "forceConsistentCasingInFileNames": true,
   "resolveJsonModule": true,
   "jsx": "preserve",
   "module": "ESNext",
   "moduleResolution": "bundler",
   "noEmitDecoratorTypes": true,
   "incremental": true,
   "allowImportingTsExtensions": true,
   "experimentalDecorators": true,
   "emitDecoratorMetadata": true,
   "declaration": true,
   "declarationMap": true,
   "sourceMap": true,
   "resolveModuleSpecifiers": true,
   "moduleResolutionExtensions": false,
   "isolatedModules": true,
   "strictBindTransform": true,
   "strictFunctionTypes": true,
   "strictPropertyInitialization": true,
   "strictEmptyTypes": true,
   "strictNullChecks": true,
   "strictParameterAnnotations": true,
   "strictReturnTypes": true,
   "alwaysStrict": true,
   "noUnusedLocals": true,
   "noUnusedParameters": true,
   "noFallthroughCasesInSwitch": true,
   "noUnusedLocalImports": true,
   "noUnusedPrivateMemberPaths": true,
   "noEmitDecoratorTypes": true,
   "noEmitDecorator": true,
   "resolveJsonModule": true,
   "isolatedModules": true,
   "skipLibCheck": true
 },
 "include": [
   "next-env.d.ts",
   "**/*.ts",
   "**/*.tsx",
   "**/*.mdx"
 ],
 "exclude": [
   ".next",
   "node_modules"
 ]
}