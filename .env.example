# FoundryOS Production & Local Environment Configuration Template
# Copy this file to .env and configure real values. NEVER commit .env to git.

# ─── 1. Server & Networking ──────────────────────────────────────────────────
PORT=8787
NODE_ENV=production
DATA_DIR=/app/data
DOMAIN_NAME=tacfos.tech

# ─── 2. Security & Master Platform Access (Fail-Closed) ──────────────────────
# Generate a cryptographically secure random 64-char hex string: openssl rand -hex 32
MASTER_ADMIN_SECRET=
SECURITY_ALERT_EMAIL=admin@tacfos.tech

# ─── 3. Database Connection (Prisma) ──────────────────────────────────────────
# Production PostgreSQL (Railway / Render / Neon / Self-Hosted):
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL=

# Local Development SQLite Fallback (used when DATABASE_URL is empty or file:...):
# DATABASE_URL=file:./data/foundry.db

# ─── 4. Stripe Billing & Subscriptions ────────────────────────────────────────
# Secret key from Stripe Dashboard (Developers -> API keys):
STRIPE_SECRET_KEY=

# Webhook signing secret (Developers -> Webhooks -> Signing secret):
STRIPE_WEBHOOK_SECRET=

# Pricing Plan IDs from Stripe Dashboard / Products:
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_ENTERPRISE=

# ─── 5. LLM Providers & AI Infrastructure (Fail-Closed) ───────────────────────
# Production NVIDIA NIM API Key (https://integrate.api.nvidia.com):
NVIDIA_API_KEY=

# Optional model override (Default: meta/llama-3.2-90b-vision-instruct):
NVIDIA_MODEL=meta/llama-3.2-90b-vision-instruct

# Optional Fallback Provider Flags:
ENABLE_FALLBACK_PROVIDERS=false
OLLAMA_HOST=
OLLAMA_MODEL=