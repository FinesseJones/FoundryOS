# FoundryOS Environment Configuration Template
# Copy this file to .env and configure real values. NEVER commit .env to git.

# Server Configuration
PORT=8787
DATA_DIR=./data

# Security & Master Platform Access
# Generate a cryptographically secure random string: openssl rand -hex 32
MASTER_ADMIN_SECRET=your_master_admin_secret_here
SECURITY_ALERT_EMAIL=admin@foundryos.tech

# Database Connection (Phase 1)
DATABASE_URL=file:./data/foundry.db

# LLM Providers (Optional for local Ollama)
NVIDIA_API_KEY=
OPENAI_API_KEY=

# Stripe Subscriptions & Billing (Phase 2 - Test Mode)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_1UAnCLLUpAOiyhmZYbRKEHk0
STRIPE_PRICE_GROWTH=price_1UAnCLLUpAOiyhmZ8AruC2Ew
STRIPE_PRICE_ENTERPRISE=price_1UAnCMLUpAOiyhmZNeAsbeOR