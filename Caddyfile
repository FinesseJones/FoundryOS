:80, :443, {$DOMAIN_NAME:localhost} {
    encode gzip

    # Backend API routes
    handle /api/* {
        reverse_proxy api:8787
    }

    # Frontend Single Page App (Pure Caddy Static Server with SPA Routing)
    handle {
        root * /srv
        file_server
        try_files {path} /index.html
    }
}
